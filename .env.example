# Copy to .env; setup.sh replaces the blank secrets with random values.
TESLAMATE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
PANEL_DATABASE_PASSWORD=
PANEL_USERS=
# Comma-separated existing usernames; used only for initial/legacy role migration.
PANEL_ADMIN_USERS=
TZ=Asia/Shanghai
VISUALIZER_BIND=127.0.0.1
TESLAMATE_BIND=127.0.0.1
GRAFANA_BIND=127.0.0.1
# Add only the trusted reverse proxy IP or dedicated Docker network CIDR.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CONTROL_API_URL=
CONTROL_API_TOKEN=
CONTROL_VIN=
TESLAMATE_VERSION=4.0.1
POSTGRES_VERSION=18-trixie

# HTTPS origin used by Fleet onboarding; e.g. https://panel.example.com
FLEET_PUBLIC_ORIGIN=
TESLA_PROXY_IMAGE=tesla/vehicle-command:0.4.1
