# 复制为 Caddyfile 后,把 tesla.example.com 换成你的域名(需已解析到本机,80/443 已放行)
# Caddy 只负责自动 HTTPS(Let's Encrypt 证书签发与续期);登录认证由面板应用层完成。
tesla.example.com {
	# 常见扫描器探测路径:直接断开连接(不消耗应用层认证失败计数)
	@scan path /.env* /.git* /.aws* /.stripe* /aws-ses.json /wp-* /xmlrpc.php /jsonrpc
	abort @scan

	# 可选:设备证书免密(指定 iPhone 免输密码,其他设备照常密码登录)。
	# 1) 运行 ./scripts/make-device-cert.sh 生成 data/pki/(CA + iphone.p12)
	# 2) 在 .env 设置 DEVICE_TRUST_TOKEN=<随机48位hex>,把下面 header_up 的值改成同值
	# 3) compose 会给 caddy 挂载 ./data/pki:/pki:ro;重建 caddy 后,在 iPhone 上
	#    先用密码登录面板,访问 /api/device/cert 下载 p12 并安装,之后免密
	# tls {
	# 	client_auth {
	# 		mode verify_if_given
	# 		trust_pool file {
	# 			pem_file /pki/device-ca.crt
	# 		}
	# 	}
	# }
	# @trusted expression {http.request.tls.client.subject} != ''
	# reverse_proxy @trusted visualizer:8080 {
	# 	header_up X-Device-Trust "<与 .env 的 DEVICE_TRUST_TOKEN 同值>"
	# }

	reverse_proxy visualizer:8080 {
		# 无证书连接:剥掉客户端可能伪造的信任头(启用上面的免密块后,整段替换为只保留本行)
		header_up -X-Device-Trust
	}
}
